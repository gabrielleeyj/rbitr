# Copy this file to .env.demo and fill in the values
# Usage: docker compose -f docker-compose.demo.yml --env-file .env.demo up --build

# Required: Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Required: At least one LLM provider key
ANTHROPIC_API_KEY=

# Optional: Override the default model
# OPENCLAW_PRIMARY_MODEL=anthropic/claude-sonnet-4-20250514

# Optional: Timezone
# TZ=Asia/Singapore

# rbitr MCP Server Configuration (set after tenant initialization)
# Get these values from the rbitr UI after setup or from setup/initialize response
# Then restart OpenClaw: docker compose -f docker-compose.demo.yml restart openclaw
RBITR_TENANT_ID=
RBITR_TENANT_KEY=
