{
  "gateway": {
    "mode": "local"
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "anthropic/claude-sonnet-4-5-20250929"
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "pairing",
      "groups": {
        "*": {
          "requireMention": true
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "rbitr": {
        "transport": "streamable-http",
        "url": "http://gateway:8080/v1/mcp/$RBITR_TENANT_ID",
        "headers": {
          "Authorization": "Bearer $RBITR_TENANT_KEY",
          "X-Agent-Id": "openclaw-telegram"
        }
      }
    }
  }
}
